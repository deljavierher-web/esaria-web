/* ============================================================
   EsarIA CRM — style.css
   ============================================================ */

:root {
  --dark:    #0F172A;
  --accent:  #6366F1;
  --accent-hover: #4F46E5;
  --bg:      #F8FAFC;
  --text:    #1E293B;
  --subtle:  #64748B;
  --border:  #E2E8F0;
  --white:   #FFFFFF;

  --radius:  8px;
  --shadow:  0 1px 4px rgba(0,0,0,.08), 0 4px 16px rgba(0,0,0,.06);
  --shadow-modal: 0 8px 32px rgba(0,0,0,.18);
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html { scroll-behavior: smooth; }

body {
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 14px;
  line-height: 1.5;
  min-height: 100vh;
}

/* ---- Header ---- */
header {
  background: var(--dark);
  color: var(--white);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(0,0,0,.25);
}

.header-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 20px;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.header-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.brand-name {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -.3px;
  color: var(--white);
}

.brand-badge {
  font-size: 11px;
  font-weight: 600;
  background: var(--accent);
  color: var(--white);
  padding: 2px 8px;
  border-radius: 20px;
  letter-spacing: .3px;
  text-transform: uppercase;
}

.header-stats {
  display: flex;
  gap: 24px;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 20px;
  font-weight: 700;
  color: var(--white);
  line-height: 1.1;
}

.stat-label {
  font-size: 11px;
  color: #94A3B8;
  white-space: nowrap;
}

/* ---- Filters ---- */
.filters {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 60px;
  z-index: 90;
}

.filters-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 10px 20px;
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
}

.filter-search {
  flex: 1;
  min-width: 180px;
  padding: 7px 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 14px;
  color: var(--text);
  background: var(--bg);
  outline: none;
  transition: border-color .15s;
}

.filter-search:focus {
  border-color: var(--accent);
}

.filter-select {
  padding: 7px 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 13px;
  color: var(--text);
  background: var(--bg);
  outline: none;
  cursor: pointer;
  transition: border-color .15s;
}

.filter-select:focus {
  border-color: var(--accent);
}

.filter-actions {
  display: flex;
  gap: 6px;
  flex-shrink: 0;
}

/* ---- Buttons ---- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 7px 13px;
  border-radius: var(--radius);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  border: 1px solid transparent;
  transition: background .15s, border-color .15s, color .15s;
  white-space: nowrap;
  text-decoration: none;
}

.btn-primary {
  background: var(--accent);
  color: var(--white);
  border-color: var(--accent);
}

.btn-primary:hover {
  background: var(--accent-hover);
  border-color: var(--accent-hover);
}

.btn-secondary {
  background: var(--white);
  color: var(--text);
  border-color: var(--border);
}

.btn-secondary:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.btn-ghost {
  background: transparent;
  color: var(--subtle);
  border-color: var(--border);
  font-size: 12px;
  padding: 5px 10px;
}

.btn-ghost:hover {
  color: var(--accent);
  border-color: var(--accent);
}

.btn-sm {
  font-size: 12px;
  padding: 4px 10px;
}

/* ---- Leads grid ---- */
.leads-grid {
  max-width: 1280px;
  margin: 0 auto;
  padding: 24px 20px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 16px;
}

/* Empty state */
.empty-state {
  grid-column: 1 / -1;
  text-align: center;
  padding: 60px 20px;
  color: var(--subtle);
}

.empty-state p {
  font-size: 15px;
  margin-top: 8px;
}

/* ---- Card ---- */
.card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 16px;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: box-shadow .15s, border-color .15s;
}

.card:hover {
  box-shadow: 0 4px 20px rgba(0,0,0,.1);
  border-color: #CBD5E1;
}

.card-header {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.card-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.3;
}

.card-badges {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
}

.card-meta {
  font-size: 12px;
  color: var(--subtle);
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.card-problema {
  font-size: 12px;
  color: var(--subtle);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  border-left: 2px solid var(--border);
  padding-left: 8px;
}

.card-actions {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-top: 2px;
}

/* ---- Badges ---- */
.badge {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 20px;
  white-space: nowrap;
  line-height: 1.6;
}

/* Prioridad */
.badge-alta     { background: #FEF2F2; color: #DC2626; }
.badge-media    { background: #FFFBEB; color: #D97706; }
.badge-baja     { background: #F0FDF4; color: #16A34A; }

/* Estado */
.badge-nuevo           { background: #EFF6FF; color: #2563EB; }
.badge-investigado     { background: #F5F3FF; color: #7C3AED; }
.badge-llamado         { background: #FFFBEB; color: #D97706; }
.badge-reunion         { background: #F0FDF4; color: #16A34A; }
.badge-descartado      { background: #F1F5F9; color: #64748B; }

/* Sector */
.badge-sector { background: #EFF6FF; color: #1D4ED8; }

/* ---- Modal ---- */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, .55);
  z-index: 200;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 20px;
  overflow-y: auto;
}

.modal-overlay.hidden {
  display: none;
}

.modal {
  background: var(--white);
  border-radius: 12px;
  width: 100%;
  max-width: 680px;
  padding: 28px;
  position: relative;
  box-shadow: var(--shadow-modal);
  margin: auto;
}

.modal-close {
  position: absolute;
  top: 16px;
  right: 16px;
  background: none;
  border: none;
  font-size: 22px;
  color: var(--subtle);
  cursor: pointer;
  line-height: 1;
  padding: 4px 8px;
  border-radius: 6px;
  transition: background .15s, color .15s;
}

.modal-close:hover {
  background: var(--bg);
  color: var(--text);
}

/* Modal sections */
.modal-section {
  margin-bottom: 22px;
}

.modal-section:last-child {
  margin-bottom: 0;
}

.modal-section-title {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .6px;
  color: var(--subtle);
  margin-bottom: 10px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--border);
}

.modal-empresa-name {
  font-size: 20px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 6px;
}

.modal-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 16px;
}

@media (max-width: 480px) {
  .modal-grid { grid-template-columns: 1fr; }
}

.modal-field label {
  display: block;
  font-size: 11px;
  font-weight: 600;
  color: var(--subtle);
  margin-bottom: 2px;
  text-transform: uppercase;
  letter-spacing: .4px;
}

.modal-field span,
.modal-field a {
  font-size: 13px;
  color: var(--text);
  word-break: break-word;
}

.modal-field a {
  color: var(--accent);
  text-decoration: none;
}

.modal-field a:hover {
  text-decoration: underline;
}

.modal-field-full {
  grid-column: 1 / -1;
}

/* Script/message box */
.script-box {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px 14px;
  font-size: 13px;
  color: var(--text);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
  margin-bottom: 8px;
}

.copy-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

/* Estado / Notas */
.estado-row {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-bottom: 10px;
}

.estado-select {
  flex: 1;
  padding: 7px 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 13px;
  color: var(--text);
  background: var(--bg);
  outline: none;
  cursor: pointer;
}

.estado-select:focus {
  border-color: var(--accent);
}

.notas-textarea {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 13px;
  color: var(--text);
  background: var(--bg);
  resize: vertical;
  min-height: 80px;
  font-family: inherit;
  outline: none;
  transition: border-color .15s;
}

.notas-textarea:focus {
  border-color: var(--accent);
}

/* Inline copy field */
.copy-field {
  display: flex;
  align-items: center;
  gap: 6px;
}

.copy-field span {
  font-size: 13px;
  color: var(--text);
}

/* ---- Toast ---- */
.toast {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 999;
  background: var(--dark);
  color: var(--white);
  padding: 10px 18px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  box-shadow: 0 4px 16px rgba(0,0,0,.25);
  pointer-events: none;
  opacity: 1;
  transition: opacity .3s;
}

.toast.hidden {
  display: none;
}

/* ---- View toggle ---- */
.view-toggle {
  display: inline-flex;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--bg);
}
.view-btn {
  background: transparent;
  border: none;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 500;
  color: var(--subtle);
  cursor: pointer;
  border-right: 1px solid var(--border);
  transition: background .15s, color .15s;
}
.view-btn:last-child { border-right: none; }
.view-btn:hover { color: var(--accent); }
.view-btn.active {
  background: var(--accent);
  color: var(--white);
}

/* ---- Bulk bar ---- */
.bulk-bar {
  max-width: 1280px;
  margin: 0 auto;
  padding: 8px 20px;
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
  border-top: 1px solid var(--border);
  background: #FFFBEB;
}
.bulk-bar.hidden { display: none; }
.bulk-count {
  font-weight: 600;
  color: var(--text);
  font-size: 13px;
  margin-right: 4px;
}

/* ---- Card select ---- */
.card { position: relative; }
.card-select {
  position: absolute;
  top: 12px;
  right: 12px;
}
.card-checkbox {
  width: 16px;
  height: 16px;
  cursor: pointer;
}
.card.selected {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(99, 102, 241, .2);
}

/* ---- Tags ---- */
.badge-tag {
  background: #ECFDF5;
  color: #059669;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.tag-remove {
  background: transparent;
  border: none;
  color: inherit;
  cursor: pointer;
  font-size: 14px;
  line-height: 1;
  padding: 0;
  margin-left: 2px;
  opacity: .6;
}
.tag-remove:hover { opacity: 1; }
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
  padding: 6px 0;
}
.tag-input {
  border: 1px dashed var(--border);
  border-radius: 20px;
  padding: 3px 10px;
  font-size: 12px;
  outline: none;
  min-width: 120px;
}
.tag-input:focus { border-color: var(--accent); }

/* ---- Tabla ---- */
.leads-table {
  max-width: 1280px;
  margin: 0 auto;
  padding: 16px 20px;
  overflow-x: auto;
}
.leads-table.hidden { display: none; }
.data-table {
  width: 100%;
  border-collapse: collapse;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  font-size: 13px;
}
.data-table th, .data-table td {
  padding: 8px 10px;
  text-align: left;
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}
.data-table th {
  background: var(--bg);
  font-weight: 600;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .4px;
  color: var(--subtle);
}
.data-table tbody tr:hover { background: #F8FAFC; }
.data-table tr.row-selected { background: #EFF6FF !important; }
.data-table input[type="checkbox"] { cursor: pointer; }

/* ---- Kanban ---- */
.leads-kanban {
  max-width: 1280px;
  margin: 0 auto;
  padding: 16px 20px;
  overflow-x: auto;
}
.leads-kanban.hidden { display: none; }
.kanban-board {
  display: grid;
  grid-template-columns: repeat(5, minmax(220px, 1fr));
  gap: 12px;
  min-width: 1100px;
}
.kanban-col {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  display: flex;
  flex-direction: column;
  min-height: 200px;
}
.kanban-col.drop-target { border-color: var(--accent); background: #EFF6FF; }
.kanban-col-header {
  padding: 10px 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--border);
}
.kanban-count {
  font-size: 11px;
  font-weight: 700;
  color: var(--subtle);
  background: var(--white);
  border-radius: 10px;
  padding: 1px 8px;
}
.kanban-col-body {
  padding: 8px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}
.kanban-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 10px;
  cursor: pointer;
  font-size: 12px;
  transition: box-shadow .15s, transform .1s;
}
.kanban-card:hover { box-shadow: var(--shadow); }
.kanban-card.dragging { opacity: .5; transform: scale(.98); }
.kanban-card-title { font-weight: 600; font-size: 13px; margin-bottom: 4px; }
.kanban-card-meta {
  display: flex;
  gap: 6px;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 4px;
  color: var(--subtle);
}
.kanban-card-decisor { color: var(--subtle); font-size: 11px; }
.kanban-empty {
  text-align: center;
  color: var(--subtle);
  font-size: 12px;
  padding: 14px;
}

/* ---- Modal toolbar y edición ---- */
.modal-toolbar {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-bottom: 14px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}
.edit-input, .edit-textarea {
  width: 100%;
  padding: 7px 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 13px;
  font-family: inherit;
  background: var(--white);
  outline: none;
  transition: border-color .15s;
}
.edit-input:focus, .edit-textarea:focus { border-color: var(--accent); }
.edit-textarea { min-height: 70px; resize: vertical; }

/* ---- Historial ---- */
.hist-item {
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 6px;
  background: var(--bg);
}
.hist-head {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
}
.hist-fecha {
  font-size: 11px;
  color: var(--subtle);
  flex: 1;
}
.hist-notas {
  font-size: 12px;
  color: var(--text);
  margin-top: 4px;
  line-height: 1.4;
}
.hist-del {
  border: none;
  background: transparent;
  font-size: 16px;
  color: var(--subtle);
  cursor: pointer;
  padding: 0 6px;
  line-height: 1;
}
.hist-del:hover { color: #DC2626; }
.empty-hist {
  font-size: 12px;
  color: var(--subtle);
  text-align: center;
  padding: 8px;
  font-style: italic;
}
.historial-form {
  display: grid;
  grid-template-columns: 1fr 1fr 2fr auto;
  gap: 6px;
  margin-top: 8px;
}
@media (max-width: 640px) {
  .historial-form { grid-template-columns: 1fr; }
}

/* ---- Modal pequeño (confirm) ---- */
.modal-small { max-width: 420px; }

.hidden { display: none !important; }

/* ---- Responsive ---- */
@media (max-width: 640px) {
  .header-inner {
    height: auto;
    padding: 12px 16px;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .filters-inner {
    gap: 6px;
  }

  .filter-search {
    min-width: 100%;
  }

  .filter-select {
    flex: 1;
    min-width: 0;
  }

  .leads-grid {
    padding: 16px;
    grid-template-columns: 1fr;
  }

  .modal {
    padding: 20px 16px;
  }

  .modal-overlay {
    padding: 12px;
    align-items: flex-start;
  }
}
